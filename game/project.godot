; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="鲸鱼女仆 · 暖光玩具房 V30"
run/main_scene="res://room.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")
config/icon="res://icon.svg"

[debug]

movie_writer/mjpeg_quality=0.87
movie_writer/fps=60

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"


[physics]

common/physics_interpolation=true

[rendering]

lights_and_shadows/contact_shadow/enabled=true
lights_and_shadows/contact_shadow/shadow_length=1.0
lights_and_shadows/contact_shadow/surface_thickness=0.006
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/multi_bounce_occlusion/enabled=true
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
reflections/sky_reflections/ggx_samples=256
reflections/sky_reflections/fast_filter_high_quality=true
reflections/reflection_atlas/reflection_size=1024
reflections/reflection_atlas/reflection_count=8
textures/default_filters/anisotropic_filtering_level=4
camera/depth_of_field/depth_of_field_bokeh_quality=3
environment/ssao/quality=4
environment/ssao/half_size=false
environment/ssao/adaptive_target=1.0
environment/ssil/quality=4
environment/ssil/half_size=false
environment/ssil/adaptive_target=1.0
anti_aliasing/quality/use_debanding=true
environment/screen_space_reflection/half_size=false
environment/subsurface_scattering/subsurface_scattering_quality=3
environment/volumetric_fog/volume_size=160
environment/volumetric_fog/volume_depth=128
environment/defaults/default_clear_color=Color(0.025, 0.022, 0.017, 1)
lightmapping/bake_performance/max_rays_per_pass=1
lightmapping/bake_performance/region_size=32
lightmapping/bake_performance/max_transparency_rays=4
lightmapping/bake_performance/max_rays_per_probe_pass=4
anti_aliasing/quality/use_taa=true
lights_and_shadows/positional_shadow/atlas_size=8192
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=1
